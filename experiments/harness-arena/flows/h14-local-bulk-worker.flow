Goal: implement the H14 mergeDuplicates fixture with public TDD gates

memory:
  task_brief
  route_policy
  policy_version

flow:
  remember key="policy_version" value="hybrid-routing-v0"
  remember key="route_policy" value="Local worker owns the H14 implementation and public tests only. Hidden oracle details are not available."

  prompt: Read TASK.md, src/contacts.js, and src/test.js. Add at least five tests in src/test.js that call mergeDuplicates and cover basic merge, later non-empty field priority, older non-empty fallback, no duplicates, and multiple duplicate groups. Destructure mergeDuplicates from require('./contacts') in src/test.js before calling it. Then implement mergeDuplicates in src/contacts.js and export it without removing the existing createContact, findByEmail, addContact, or removeContact exports. Merge each field independently: later non-empty values replace earlier non-empty values, but later empty strings or null values do not erase earlier non-empty values. Do not write local-worker-summary.md until the public checks pass.

  retry max 4
    run: node -e "const fs=require('fs'); const contactsSource=fs.readFileSync('src/contacts.js','utf8'); const tests=fs.readFileSync('src/test.js','utf8'); const count=(tests.match(/test\\s*\\(\\s*['\\\"][^'\\\"]*(merge|duplicate)[^'\\\"]*['\\\"]/gi)||[]).length; const importsMerge=/const\\s*\\{[^}]*\\bmergeDuplicates\\b[^}]*\\}\\s*=\\s*require\\(['\\\"]\\.\\/contacts['\\\"]\\)/.test(tests); const exports=['createContact','findByEmail','addContact','removeContact','mergeDuplicates']; const missing=exports.filter((name)=>!new RegExp('module\\\\.exports\\\\s*=.*\\\\b'+name+'\\\\b','s').test(contactsSource)); if (!contactsSource.includes('mergeDuplicates')) { console.error('mergeDuplicates missing in src/contacts.js'); process.exit(1); } if (missing.length) { console.error('missing exports: '+missing.join(',')); process.exit(1); } if (!importsMerge) { console.error('src/test.js must destructure mergeDuplicates from require(./contacts) before calling it'); process.exit(1); } if (count < 5) { console.error('expected at least 5 merge/duplicate tests, found '+count); process.exit(1); } const {createContact,findByEmail,addContact,removeContact,mergeDuplicates}=require('./src/contacts'); const alice=createContact('Alice','alice@test.com','555','Acme'); if (alice.name!=='Alice'||alice.email!=='alice@test.com'||alice.phone!=='555'||alice.company!=='Acme') { console.error('createContact positional API changed'); process.exit(1); } const list=[alice,createContact('Bob','bob@test.com','556',null),createContact('Alice2','alice@test.com','557','Globex')]; if (findByEmail(list,'alice@test.com').length!==2) { console.error('findByEmail array API changed'); process.exit(1); } if (addContact([alice],list[1]).length!==2) { console.error('addContact array API changed'); process.exit(1); } if (removeContact(list,'bob@test.com').length!==2) { console.error('removeContact array API changed'); process.exit(1); } const later=mergeDuplicates([createContact('Alice','same@test.com','555','Acme'),createContact('Alice A','same@test.com','777','Globex')])[0]; if (later.name!=='Alice A'||later.phone!=='777'||later.company!=='Globex') { console.error('mergeDuplicates later non-empty priority failed'); process.exit(1); } const fallback=mergeDuplicates([createContact('Alice','fallback@test.com','555','Acme'),createContact('','fallback@test.com','','')])[0]; if (fallback.name!=='Alice'||fallback.phone!=='555'||fallback.company!=='Acme') { console.error('mergeDuplicates older non-empty fallback failed'); process.exit(1); }"
    if command_failed
      prompt: The public structural gate failed. Fix only src/test.js and src/contacts.js so mergeDuplicates is implemented, exported, and destructured from require('./contacts') in src/test.js before use. Preserve all original contacts exports and positional function signatures. Add at least five merge/duplicate tests. Merge fields independently: later non-empty values win, while later empty strings or null values do not erase earlier non-empty values. Gate output: ${last_stdout} ${last_stderr}
    end
  end

  retry max 6
    run: npm test [timeout 120]
    if command_failed
      prompt: Public tests are failing. Fix only src/test.js and src/contacts.js. Preserve the existing createContact, findByEmail, addContact, and removeContact behavior. Ensure src/test.js imports mergeDuplicates before calling it. Implement the required merge behavior per field: later non-empty fields override, older non-empty fields remain when later fields are empty or null, and unique emails stay present. Test output: ${last_stdout} ${last_stderr}
    end
  end

  prompt: Use a write_file action to create local-worker-summary.md at the workspace root. Include changed files, checks run, failures, timeout/no-edit status, inputArtifactRefs, outputArtifactRefs, and diffSummary. Do not mention or infer hidden oracle implementation details.

  retry max 2
    run: node -e "process.exit(require('node:fs').existsSync('local-worker-summary.md') ? 0 : 1)"
    if command_failed
      prompt: local-worker-summary.md is still missing. Use a write_file action now to create local-worker-summary.md at the workspace root with changed files, checks run, failures, timeout/no-edit status, inputArtifactRefs, outputArtifactRefs, and diffSummary.
    end
  end

done when:
  file_exists local-worker-summary.md
  gate h14_public_contract: node -e "const fs=require('fs'); const contactsSource=fs.readFileSync('src/contacts.js','utf8'); const tests=fs.readFileSync('src/test.js','utf8'); const count=(tests.match(/test\\s*\\(\\s*['\\\"][^'\\\"]*(merge|duplicate)[^'\\\"]*['\\\"]/gi)||[]).length; const importsMerge=/const\\s*\\{[^}]*\\bmergeDuplicates\\b[^}]*\\}\\s*=\\s*require\\(['\\\"]\\.\\/contacts['\\\"]\\)/.test(tests); const exports=['createContact','findByEmail','addContact','removeContact','mergeDuplicates']; const missing=exports.filter((name)=>!new RegExp('module\\\\.exports\\\\s*=.*\\\\b'+name+'\\\\b','s').test(contactsSource)); if (!contactsSource.includes('mergeDuplicates')) process.exit(1); if (missing.length) process.exit(1); if (!importsMerge) process.exit(1); if (count < 5) process.exit(1); const {createContact,findByEmail,addContact,removeContact,mergeDuplicates}=require('./src/contacts'); const alice=createContact('Alice','alice@test.com','555','Acme'); if (alice.name!=='Alice'||alice.email!=='alice@test.com'||alice.phone!=='555'||alice.company!=='Acme') process.exit(1); const list=[alice,createContact('Bob','bob@test.com','556',null),createContact('Alice2','alice@test.com','557','Globex')]; if (findByEmail(list,'alice@test.com').length!==2) process.exit(1); if (addContact([alice],list[1]).length!==2) process.exit(1); if (removeContact(list,'bob@test.com').length!==2) process.exit(1); const later=mergeDuplicates([createContact('Alice','same@test.com','555','Acme'),createContact('Alice A','same@test.com','777','Globex')])[0]; if (later.name!=='Alice A'||later.phone!=='777'||later.company!=='Globex') process.exit(1); const fallback=mergeDuplicates([createContact('Alice','fallback@test.com','555','Acme'),createContact('','fallback@test.com','','')])[0]; if (fallback.name!=='Alice'||fallback.phone!=='555'||fallback.company!=='Acme') process.exit(1);"
  gate public_tests: npm test
