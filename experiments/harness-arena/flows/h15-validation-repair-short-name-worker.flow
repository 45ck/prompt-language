Goal: repair one H15 PATCH validation assertion without broad endpoint ownership

memory:
  task_brief
  route_policy
  policy_version

flow:
  remember key="policy_version" value="h15-validation-repair-short-name-v1"
  remember key="route_policy" value="Local worker owns exactly one public validation repair in src/app.js. Public tests are already written. Do not edit src/test.js."

  prompt: Read TASK.md, src/app.js, and src/test.js. Fix the named public failure only: patchContact(1, { name: 'A' }) already returns status 400, but it must also return a response body with an error field. Edit only src/app.js. Preserve existing exports and GET, POST, DELETE, and successful PATCH behavior. Do not edit src/test.js. Do not relax valid + phone support, non-string rejection, or long-field limits. Run node src/test.js.

  retry max 2
    run: node src/test.js [timeout 120]
    if command_failed
      prompt: Public tests are failing. Fix only src/app.js. The intended repair is the short-name validation response body for patchContact. Preserve + phone support, non-string rejection, and long-field limits. Do not edit src/test.js. Test output: ${last_stdout} ${last_stderr}
    end
  end

  prompt: Use a write_file action to create local-worker-summary.md at the workspace root. Include changed files, checks run, failures, timeout/no-edit status, inputArtifactRefs, outputArtifactRefs, and diffSummary. Do not mention or infer hidden oracle implementation details.

  retry max 2
    run: node -e "process.exit(require('node:fs').existsSync('local-worker-summary.md') ? 0 : 1)"
    if command_failed
      prompt: local-worker-summary.md is still missing. Use a write_file action now to create local-worker-summary.md at the workspace root with changed files, checks run, failures, timeout/no-edit status, inputArtifactRefs, outputArtifactRefs, and diffSummary.
    end
  end

done when:
  file_exists local-worker-summary.md
  gate public_tests: node src/test.js
  gate test_file_preserved: node -e "const fs=require('fs'); const tests=fs.readFileSync('src/test.js','utf8'); if (!tests.includes('patch short name validation includes an error body')) process.exit(1); if (!tests.includes('patch partial update preserves other fields')) process.exit(1);"
  gate api_preserved: node -e "const app=require('./src/app'); for (const name of ['listContacts','getContact','createContact','deleteContact','patchContact','contacts']) if (!(name in app)) process.exit(1); const deleted=app.deleteContact(app.createContact({name:'Delete Candidate',email:'delete.candidate@example.com'}).body.id); if (deleted.status!==204||deleted.body!==null) process.exit(1); const short=app.patchContact(1,{name:'A'}); if (short.status!==400||!short.body||typeof short.body.error!=='string') process.exit(1); const phone=app.patchContact(2,{phone:'+1 555-0199'}); if (phone.status!==200||phone.body.phone!=='+1 555-0199') process.exit(1); for (const bad of [{name:null},{email:null},{phone:'+1 555 0101 0101 0101 9999'},{company:'C'.repeat(201)},{company:123}]) { const result=app.patchContact(1,bad); if (result.status!==400||!result.body?.error) process.exit(1); }"
