{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-language.local/experiments/harness-arena/hybrid-routing-manifest.schema.json",
  "title": "Hybrid model routing run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "runId",
    "taskId",
    "arm",
    "runGroupId",
    "claimStatus",
    "repo",
    "budget",
    "evidencePolicy",
    "startedAt",
    "completedAt",
    "steps",
    "oracle"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": ["local-only", "frontier-only", "advisor-only", "hybrid-router"]
    },
    "runGroupId": {
      "type": "string",
      "minLength": 1
    },
    "claimStatus": {
      "enum": [
        "structure-only-not-model-evidence",
        "fake-live-deterministic-not-model-evidence",
        "live-model-evidence"
      ]
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frontierCallLimit",
        "usdLimit",
        "wallSecondsLimit",
        "localRepairAttemptLimit",
        "retryPolicy",
        "enforced"
      ],
      "properties": {
        "frontierCallLimit": {
          "type": "integer",
          "minimum": 0
        },
        "usdLimit": {
          "type": "number",
          "minimum": 0
        },
        "wallSecondsLimit": {
          "type": "integer",
          "minimum": 1
        },
        "localRepairAttemptLimit": {
          "type": "integer",
          "minimum": 0
        },
        "retryPolicy": {
          "type": "string",
          "minLength": 1
        },
        "enforced": {
          "type": "boolean"
        }
      }
    },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestAuthor",
        "oracleVisibility",
        "commandEnvironmentPolicy",
        "commandSafetyPolicy",
        "providerFallbackPolicy",
        "localOnlyAllowsFrontierInput"
      ],
      "properties": {
        "manifestAuthor": {
          "enum": ["harness", "model", "operator"]
        },
        "oracleVisibility": {
          "enum": ["private-artifacts-only", "model-visible"]
        },
        "commandEnvironmentPolicy": {
          "enum": ["parent-env-inherited", "minimal-allowlist"]
        },
        "commandSafetyPolicy": {
          "enum": ["deny-high-risk", "unrestricted"]
        },
        "providerFallbackPolicy": {
          "enum": ["forbid", "record-and-invalidate", "allow"]
        },
        "localOnlyAllowsFrontierInput": {
          "type": "boolean"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stepId",
          "purpose",
          "runner",
          "model",
          "provider",
          "endpoint",
          "requestedModel",
          "actualModel",
          "providerSubstitution",
          "adapterVersion",
          "providerClass",
          "routeDecision",
          "routeTrigger",
          "riskLevel",
          "ambiguityLevel",
          "attemptNumber",
          "promptProgram",
          "cost",
          "dataClassification",
          "frontierCallKind",
          "cwd",
          "startedAt",
          "completedAt",
          "exitCode",
          "timedOut"
        ],
        "properties": {
          "stepId": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "runner": {
            "enum": ["aider", "codex", "ollama", "opencode", "prompt-language", "shell", "other"]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "endpoint": {
            "type": ["string", "null"]
          },
          "requestedModel": {
            "type": "string",
            "minLength": 1
          },
          "actualModel": {
            "type": "string",
            "minLength": 1
          },
          "providerSubstitution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["occurred", "reason"],
            "properties": {
              "occurred": {
                "type": "boolean"
              },
              "reason": {
                "type": ["string", "null"]
              }
            }
          },
          "adapterVersion": {
            "type": "string",
            "minLength": 1
          },
          "providerClass": {
            "enum": ["local", "frontier", "deterministic"]
          },
          "routeDecision": {
            "enum": ["local", "frontier", "deterministic"]
          },
          "routeTrigger": {
            "type": "string",
            "minLength": 1
          },
          "riskLevel": {
            "enum": ["low", "medium", "high"]
          },
          "ambiguityLevel": {
            "enum": ["low", "medium", "high"]
          },
          "escalationReason": {
            "type": ["string", "null"]
          },
          "attemptNumber": {
            "type": "integer",
            "minimum": 1
          },
          "promptProgram": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256"],
            "properties": {
              "kind": {
                "enum": ["flow", "prompt", "synthetic", "shell"]
              },
              "path": {
                "type": ["string", "null"]
              },
              "sha256": {
                "type": ["string", "null"]
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basis",
              "estimatedUsd",
              "providerReportedUsd",
              "inputTokens",
              "outputTokens",
              "pricingVersion"
            ],
            "properties": {
              "basis": {
                "enum": ["none", "provider-reported", "estimated"]
              },
              "estimatedUsd": {
                "type": "number",
                "minimum": 0
              },
              "providerReportedUsd": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "inputTokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "outputTokens": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "pricingVersion": {
                "type": ["string", "null"]
              }
            }
          },
          "dataClassification": {
            "enum": ["public", "internal", "private-oracle"]
          },
          "frontierCallKind": {
            "enum": ["none", "classifier", "advisor", "repair", "review", "full-work"]
          },
          "inputArtifactRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputArtifactRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resourceSnapshotArtifactRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resourceSnapshotSummary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "totalArtifactRefCount",
              "beforeAfterArtifactRefCount",
              "sampleArtifactRefCount",
              "sampleCount",
              "sampleNonzeroExitCount",
              "sampleMetadataParseFailureCount",
              "sampleStdoutNonEmptyCount",
              "sampleStderrNonEmptyCount"
            ],
            "properties": {
              "totalArtifactRefCount": {
                "type": "integer",
                "minimum": 0
              },
              "beforeAfterArtifactRefCount": {
                "type": "integer",
                "minimum": 0
              },
              "sampleArtifactRefCount": {
                "type": "integer",
                "minimum": 0
              },
              "sampleCount": {
                "type": "integer",
                "minimum": 0
              },
              "sampleNonzeroExitCount": {
                "type": "integer",
                "minimum": 0
              },
              "sampleMetadataParseFailureCount": {
                "type": "integer",
                "minimum": 0
              },
              "sampleStdoutNonEmptyCount": {
                "type": "integer",
                "minimum": 0
              },
              "sampleStderrNonEmptyCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "stdoutArtifactRef": {
            "type": "string",
            "minLength": 1
          },
          "stderrArtifactRef": {
            "type": "string",
            "minLength": 1
          },
          "diffSummary": {
            "type": "string"
          },
          "reviewDefects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "exitCode": {
            "type": ["integer", "null"]
          },
          "timedOut": {
            "type": "boolean"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "wallSeconds": {
            "type": "number",
            "minimum": 0
          },
          "estimatedUsd": {
            "type": "number",
            "minimum": 0
          },
          "gpuActiveSeconds": {
            "type": "number",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandArtifactRef", "commandSha256", "visibility", "exitCode", "passed"],
      "properties": {
        "commandArtifactRef": {
          "type": "string",
          "minLength": 1
        },
        "commandSha256": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": ["private-artifacts-only", "model-visible"]
        },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "passed": {
          "type": "boolean"
        },
        "passes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "total": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "summary": {
          "type": "string"
        },
        "timedOut": {
          "type": "boolean"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "stdoutArtifactRef": {
          "type": "string",
          "minLength": 1
        },
        "stderrArtifactRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routingPolicyFailure": {
          "type": "boolean"
        },
        "modelFailure": {
          "type": "boolean"
        },
        "harnessFailure": {
          "type": "boolean"
        },
        "resourceFailure": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
